{
  "name": "@pgmi-builds/agent-omp-sdk",
  "version": "0.1.0",
  "description": "OMP (SDK) provider for DeepSeek Harness (dsh) — the OPT-IN in-process SDK transport for the OMP coding agent: one bun sidecar hosts N Dash sessions and reuses a single authStorage/modelRegistry. Delivered DISABLED by default (roster key `omp-sdk`); the RPC line (@pgmi-builds/agent-omp) is the primary path because it drives the operator's own `omp` binary with zero bundled runtime. This package declares NO SDK/bun dependency and ships NO postinstall: the durable runtime (bun + the pinned coding-agent package + this package's sidecar) is fetched into the world home on the first real prompt (src/sdk-runtime.ts, `npm run fetch-sdk-runtime`).",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./world": "./dist/world-plugin.js"
  },
  "files": [
    "dist",
    "sidecar",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "fetch-sdk-runtime": "node scripts/fetch-sdk-runtime.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-scope": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-0 <0.3.0-0",
    "@pgmi-builds/superd-hub": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@pgmi-builds/superd-hub": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgmi-builds/superd.git"
  },
  "engines": {
    "node": ">=22.18"
  }
}
