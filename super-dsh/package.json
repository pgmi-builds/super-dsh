    "@deepseek-ai/dsh-user-approval": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-cmdline": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-plugin-manager": ">=0.1.5-0 <0.3.0-0"
  },
