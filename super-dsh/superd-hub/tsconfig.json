{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  // The client half is tsdown territory (lib/client) — EXCEPT mesh-api.ts,
  // which is node-safe (no DOM, no react, no @deepseek-ai imports) and dual-
  // emits to dist/client/mesh-api.js so test/client-mesh-view.test.mjs can
  // import its pure halves under node --test (the switch-core/toast-core
  // precedent, kept inside src/client). New client .ts files default to the
  // tsdown lane: list them here unless they are node-safe test seams too.
  "exclude": [
    "src/client/index.ts",
    "src/client/roster.ts",
    "src/client/switch.ts",
    "src/client/toast.ts"
  ]
}
