{
  "name": "@pgmi-builds/superd-hub",
  "version": "0.1.0",
  "description": "Super D hub host half: world inventory control plane, roster, world spawner and the single-origin per-world mount carrier (no server-side selection; the addressed world is the request's mount path)",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client/index.js",
    "./world": "./dist/world-entry.js",
    "./join": "./dist/world-join.js",
    "./web-trust": "./dist/web-trust.js",
    "./a2a": "./dist/a2a-row.js",
    "./foreign-hub": "./dist/foreign-hub.js",
    "./foreign-native": "./dist/foreign-native.js",
    "./foreign-claude": "./dist/foreign-claude.js",
    "./foreign-agy": "./dist/foreign-agy.js"
  },
  "files": [
    "dist",
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "build:icons": "node scripts/build-icon-assets.mjs",
    "build-client": "npm run build:icons && npm run typecheck:client && node scripts/build-client.mjs",
    "test": "node --test --test-reporter=spec --test-concurrency=8 --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/react": "18.3.31",
    "tsdown": "^0.15.12",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
