{
  "name": "@pgmi-builds/aw-routing",
  "version": "0.1.0",
  "description": "App-level runtime selector + gateway routing host half for the superd multi-context route (ONE selector; UI is a pure projection of the selected runtime)",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client/index.js"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "build-client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsdown": "^0.15.12",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "private": true
}
